    {
      "_meta": null,
      "annotations": null,
      "description": "只读分析 unified diff 的变更风险；不写入文件、不调用外部服务，且没有副作用。",
      "execution": null,
      "icons": null,
      "inputSchema": {
        "properties": {
          "diff_text": {
            "title": "Diff Text",
            "type": "string"
          }
        },
        "required": [
          "diff_text"
        ],
        "title": "validate_patchArguments",
        "type": "object"
      },
      "name": "validate_patch",
      "outputSchema": {
        "$defs": {
          "Decision": {
            "description": "Possible safety outcomes for a submitted change.",
            "enum": [
              "ALLOW",
              "BLOCK",
              "CHECK_INCOMPLETE"
            ],
            "title": "Decision",
            "type": "string"
          },
          "Fault": {
            "description": "Evidence retained for a non-successful check condition.",
            "properties": {
              "code": {
                "$ref": "#/$defs/FaultCode"
              },
              "evidence_refs": {
                "items": {
                  "type": "string"
                },
                "title": "Evidence Refs",
                "type": "array"
              },
              "message": {
                "title": "Message",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "evidence_refs"
            ],
            "title": "Fault",
            "type": "object"
          },
          "FaultCode": {
            "description": "Machine-readable causes for incomplete or degraded checks.",
            "enum": [
              "input_validation",
              "diff_parse",
              "policy_uncovered",
              "retrieval_empty",
              "embedding_timeout",
              "cache_corrupt",
              "mcp_disconnected"
            ],
            "title": "FaultCode",
            "type": "string"
          },
          "Finding": {
            "description": "Evidence-backed result for one policy check.",
            "properties": {
              "evidence_refs": {
                "items": {
                  "type": "string"
                },
                "title": "Evidence Refs",
                "type": "array"
              },
              "finding_id": {
                "title": "Finding Id",
                "type": "string"
              },
              "message": {
                "title": "Message",
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/FindingStatus"
              }
            },
            "required": [
              "finding_id",
              "status",
              "message",
              "evidence_refs"
            ],
            "title": "Finding",
            "type": "object"
          },
          "FindingStatus": {
            "description": "Completion status of a single policy finding.",
            "enum": [
              "passed",
              "violated",
              "incomplete"
            ],
            "title": "FindingStatus",
            "type": "string"
          }
        },
        "description": "The sole JSON-compatible output contract for BizGuard decisions.",
        "properties": {
          "decision": {
            "$ref": "#/$defs/Decision"
          },
          "faults": {
            "items": {
              "$ref": "#/$defs/Fault"
            },
            "title": "Faults",
            "type": "array"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/Finding"
            },
            "title": "Findings",
            "type": "array"
          }
        },
        "required": [
          "decision",
          "findings",
          "faults"
        ],
        "title": "ChangeSafetyCard",
        "type": "object"
      },
      "title": null
    },
